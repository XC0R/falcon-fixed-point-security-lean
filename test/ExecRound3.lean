-- key 0: the first coefficients of `f, g, F` and of the computed `G`
/-- info: true -/
#guard_msgs in
#eval decide (((ofHex kat0Sk).bind decodeKey).map (fun k =>
  ((List.range 4).map fun i => (k.f (Fin.ofNat _ i), k.g (Fin.ofNat _ i), k.F (Fin.ofNat _ i),
    k.G (Fin.ofNat _ i)))) =
  some [(1, 2, 45, 16), (4, 5, -35, -19), (4, 5, -49, -45), (2, -5, 30, -4)])

-- key 0: `fG - gF = q` exactly and `h·f ≡ g (mod q)`
/-- info: true -/
#guard_msgs in
#eval decide ((do
  let k ← (ofHex kat0Sk).bind decodeKey
  let h ← (ofHex kat0Pk).bind decodePk
  pure (ntruB k, pkMatchB h k)) = some (true, true))

-- wrong header, a trailing byte, a public key value `≥ q`: rejected
/-- info: true -/
#guard_msgs in
#eval decide (((ofHex kat0Sk).map fun b => (decodeSk (b.set! 0 0x5A)).isNone &&
    (decodeSk (b.push 0)).isNone) = some true ∧
  ((ofHex kat0Pk).map fun b => (decodePk ((b.set! 1 0xFF).set! 2 0xFF)).isNone) = some true)

/-- A choice point: ties to even (operations and tables), scale-first, unbounded words, no range
checks, reused salt, cap 27. -/
def cKat : Choices :=
  { x := ⟨.halfEven, .halfEven, .direct, .plain⟩, xn := 0, target := .scaleFirst, qinv := .w77,
    word := none, rchk := none, salt := .reused, cap := 27, beta2 := 34034726, infB := none,
    samp := ⟨.plain, true, .b79⟩ }

-- key 0 passes `checkFast` at `δ45q` and `checkRangeA` at `i = 32` and `i = 64` (`W = 19`)
/-- info: true -/
#guard_msgs in
#eval decide (((ofHex kat0Sk).bind decodeKey).map (fun k => checkFast cKat.x 0 δ45q k &&
  checkRangeA cKat 32 19 k && checkRangeA cKat 64 19 k) = some true)
